{
  "name": "billy-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Billy core daemon (one audited runtime dependency: @anthropic-ai/sdk; see ADR-0003)",
  "engines": {
    "node": ">=26.1.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
